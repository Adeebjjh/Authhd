      - name: Stage on-device Python sources
        run: |
          python - <<'PYTHON'
          import pathlib, shutil
          src = pathlib.Path('bundled-source/forge-agent/runner')
          dest = pathlib.Path('bundled-source/forge-agent/android/app/src/main/python/runner')
          if dest.exists():
              shutil.rmtree(dest)
          shutil.copytree(src, dest, ignore=shutil.ignore_patterns('__pycache__'))
          print('Staged', len(list(dest.glob('*.py'))), 'Python modules for Chaquopy')
          PYTHON
      - name: Install cloud test dependency
        run: python -m pip install 'cryptography>=43,<47'
      - name: Test coding runner
        working-directory: bundled-source/forge-agent
        run: python -m unittest discover -s tests -v
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Test provider interface
        working-directory: bundled-source/forge-agent
        run: |
          npm ci --ignore-scripts
          npm run test:ui
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v4
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Build APK and run Android lint
        run: gradle -p bundled-source/forge-agent/android --no-daemon testDebugUnitTest assembleDebug lintDebug
      - uses: actions/upload-artifact@v4
        with:
          name: Forge-Agent-APK
          path: bundled-source/forge-agent/android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: Android-lint-report
          path: bundled-source/forge-agent/android/app/build/reports/lint-results-debug.html
